# CampusFlow Environment Configuration
PROJECT_NAME="CampusFlow"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
SECRET_KEY="campusflow-super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for fast zero-config dev
DATABASE_URL="sqlite:///./campusflow.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campusflow_db"

# AI Integration (Optional: Google Gemini API)
GEMINI_API_KEY=""

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
